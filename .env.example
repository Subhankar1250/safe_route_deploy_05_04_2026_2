# Production site (Vercel custom domain). Used for metadataBase / canonical URLs.
NEXT_PUBLIC_SITE_URL=https://saferoute.sishutirtha.co.in

# Optional: AI for in-app Help (POST /api/app-assistant). Server-only — never use NEXT_PUBLIC_*.
# Prefer OpenRouter (one key, many models). Fallback: direct OpenAI.
# Production: set the same vars in Vercel → Settings → Environment Variables.
# Without any key, Help still works using built-in static tips.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional for OpenRouter app listing (defaults: NEXT_PUBLIC_SITE_URL, "Safe Route")
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: harden POST /api/app-assistant (production). Comma-separated extra allowed page origins.
# APP_ASSISTANT_ALLOWED_ORIGINS=https://staging.example.com
# Skip origin check only if you know why (e.g. custom native clients without Origin).
# APP_ASSISTANT_SKIP_ORIGIN_CHECK=
# Per-IP rate limit (fixed window; serverless = per instance — use host WAF for global limits).
# APP_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
# APP_ASSISTANT_RATE_LIMIT_MAX=24

# Optional: OSRM-compatible routing base URL (no trailing slash). Default is the public OSRM demo.
# For production volume, self-host OSRM or use a paid routing API and point this to your instance.
# Example: NEXT_PUBLIC_OSRM_URL=https://router.project-osrm.org/route/v1/driving
# NEXT_PUBLIC_OSRM_URL=

# Supabase (required for the app to work — add the same keys in Vercel → Project → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use either the publishable key name or the classic anon key name (same value from Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Android/Capacitor: WebView loads this URL (same data as the website). Override when using a staging domain.
# CAPACITOR_SERVER_URL=https://saferoute.sishutirtha.co.in
# LAN dev only — if set, overrides production URL until you unset and run: npm run android:bundle
# CAPACITOR_LIVE_RELOAD_URL=http://192.168.1.x:8080

# Observability / analytics (set in .env.local and deployment env vars)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=w89u87ruz4
# Optional: separate GA4 + Clarity for /admin only (otherwise admin uses the main IDs above)
NEXT_PUBLIC_GA_ID_ADMIN=
NEXT_PUBLIC_CLARITY_ID_ADMIN=
# Optional session recording tools (use one or both)
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=
NEXT_PUBLIC_SMARTLOOK_PROJECT_KEY=

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
# Example project: saferoute-97776
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
