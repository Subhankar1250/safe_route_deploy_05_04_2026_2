# Production site (Vercel custom domain). Used for metadataBase / canonical URLs.
NEXT_PUBLIC_SITE_URL=https://saferoute.sishutirtha.co.in

# Supabase (required for the app to work — add the same keys in Vercel → Project → Settings → Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use either the publishable key name or the classic anon key name (same value from Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Android/Capacitor: WebView loads this URL (same data as the website). Override when using a staging domain.
# CAPACITOR_SERVER_URL=https://saferoute.sishutirtha.co.in
# LAN dev only — if set, overrides production URL until you unset and run: npm run android:bundle
# CAPACITOR_LIVE_RELOAD_URL=http://192.168.1.x:8080

# Observability / analytics (set in .env.local and deployment env vars)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=w89u87ruz4
# Optional: separate GA4 + Clarity for /admin only (otherwise admin uses the main IDs above)
NEXT_PUBLIC_GA_ID_ADMIN=
NEXT_PUBLIC_CLARITY_ID_ADMIN=
# Optional session recording tools (use one or both)
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=
NEXT_PUBLIC_SMARTLOOK_PROJECT_KEY=

# Firebase web app config (Firebase console → Project settings → Your apps → Web)
# Example project: saferoute-97776
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
